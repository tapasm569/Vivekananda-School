<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="3dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#CBD5E1"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Student information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivStudentAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="#E2E8F0"
                android:scaleType="centerCrop"
                android:src="@android:drawable/sym_def_app_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student Name"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0F3D6E" />

                <TextView
                    android:id="@+id/tvStudentMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Class 5 • Roll: 1"
                    android:textSize="12sp"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/tvParentsName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Father: -- | Phone: --"
                    android:textSize="11sp"
                    android:textColor="#64748B" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMonthlyFeeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="#FEF3C7"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:text="₹450/m"
                android:textColor="#D97706"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="9dp"
            android:background="#E2E8F0" />

        <!-- All actions in one horizontal row -->
        <LinearLayout
            android:id="@+id/studentActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnStudentWhatsApp"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_whatsapp"
                android:drawablePadding="4dp"
                android:text="WhatsApp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#15803D"
                android:background="@drawable/bg_action_whatsapp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="WhatsApp parent" />

            <TextView
                android:id="@+id/btnStudentCall"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.75"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_call"
                android:drawablePadding="3dp"
                android:text="Call"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:background="@drawable/bg_action_call"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Call parent" />

            <TextView
                android:id="@+id/btnCollectDue"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.8"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:paddingHorizontal="3dp"
                android:text="Collect"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_action_collect"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnStudentReceipts"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.9"
                android:gravity="center"
                android:paddingHorizontal="3dp"
                android:text="Receipt"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_action_receipt"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="View payment receipts" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
