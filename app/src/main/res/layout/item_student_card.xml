<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:strokeWidth="1dp"
    app:strokeColor="#CBD5E1"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivStudentAvatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="#E2E8F0"
            android:scaleType="centerCrop"
            android:src="@android:drawable/sym_def_app_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0F3D6E" />

            <TextView
                android:id="@+id/tvStudentMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Class 5 • Roll: 1"
                android:textSize="12sp"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/tvParentsName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Father: -- | Phone: --"
                android:textSize="11sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMonthlyFeeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FEF3C7"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="₹450/m"
            android:textColor="#D97706"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/studentActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="6dp">
            <TextView
                android:id="@+id/btnStudentWhatsApp"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text=""
                android:background="@drawable/bg_action_whatsapp"
                android:drawableTop="@drawable/ic_whatsapp"
                android:contentDescription="WhatsApp parent" />
            <TextView
                android:id="@+id/btnStudentCall"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text=""
                android:background="@drawable/bg_action_call"
                android:drawableTop="@drawable/ic_call"
                android:contentDescription="Call parent" />
            <TextView
                android:id="@+id/btnCollectDue"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="7dp"
                android:text="Collect"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#0F3D6E"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
